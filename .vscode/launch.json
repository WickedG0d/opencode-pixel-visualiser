{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Run Parallel Orchestrator",
      "program": "${workspaceFolder}/orchestrator.cjs",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Start Visualizer Server",
      "program": "${workspaceFolder}/dist/visualizer/ocv-server.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}

